

datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client"
  output   = "../generated"
}

// USER
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  username  String   @unique
  avatarUrl String?
  createdAt DateTime @default(now())

  // NOTIFICATION
  receivedNotifications Notification[] @relation("ReceivedNotifications")
  sentNotifications     Notification[] @relation("SentNotifications")

  // CHAT
  conversations ConversationMember[]
  messages      Message[]

  // COMMUNITIES
  createdCommunities   Community[]
  communityMemberships CommunityMember[]

  // articles
  articles         Article[]        @relation("ArticleAuthor")
  articleComments  ArticleComment[] @relation("ArticleCommentAuthor")
  articleLikes     ArticleLike[]
  articleBookmarks ArticleBookmark[]
}

// COMMUNITIES
model Community {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  image       String?
  creatorId   String
  createdAt   DateTime @default(now())

  creator User @relation(fields: [creatorId], references: [id])
  members CommunityMember[]
}

// COMMUNITY MEMBERS
model CommunityMember {
  id          Int      @id @default(autoincrement())
  userId      String
  communityId Int
  joinedAt    DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([userId, communityId])
}

// NOTIFICATION
model Notification {
  id        String   @id @default(cuid())
  userId    String
  actorId   String?
  type      String
  postId    String?
  message   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user  User  @relation("ReceivedNotifications", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("SentNotifications", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

// CHAT
model Conversation {
  id        String   @id @default(cuid())
  type      String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  ConversationMember[]
  messages Message[]
}

model ConversationMember {
  conversationId String
  userId         String
  status         String   @default("active")
  lastReadAt     DateTime @default(now())
  joinedAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId, status])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ARTICLES

model Article {
  id            String   @id @default(cuid())
  authorId      String
  title         String
  content       String
  coverImageUrl String?
  status        String   @default("published")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  publishedAt   DateTime?

  author        User             @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  comments      ArticleComment[]
  likes         ArticleLike[]
  bookmarks     ArticleBookmark[]

  @@index([authorId, createdAt])
  @@index([status, publishedAt])
}

model ArticleComment {
  id        String   @id @default(cuid())
  articleId String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User    @relation("ArticleCommentAuthor", fields: [userId], references: [id], onDelete: Cascade)

  @@index([articleId, createdAt])
  @@index([userId])
}

model ArticleLike {
  id        String   @id @default(cuid())
  articleId String
  userId    String
  createdAt DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([articleId, userId])
  @@index([userId])
}

model ArticleBookmark {
  id        String   @id @default(cuid())
  articleId String
  userId    String
  createdAt DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([articleId, userId])
  @@index([userId, createdAt])
}


