generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String               @id @default(cuid())
  email                 String               @unique
  name                  String?
  username              String               @unique
  avatarUrl             String?
  createdAt             DateTime             @default(now())
  articles              Article[]            @relation("ArticleAuthor")
  articleBookmarks      ArticleBookmark[]
  articleComments       ArticleComment[]     @relation("ArticleCommentAuthor")
  articleLikes          ArticleLike[]
  bookmarks             Bookmark[]
  createdCommunities    Community[]
  communityMemberships  CommunityMember[]
  conversations         ConversationMember[]
  createdLists          List[]               @relation("ListOwner")
  listMemberships       ListMember[]
  messages              Message[]
  sentNotifications     Notification[]       @relation("SentNotifications")
  receivedNotifications Notification[]       @relation("ReceivedNotifications")
  userSettings UserSettings?
}

model Community {
  id          Int               @id @default(autoincrement())
  name        String            @unique
  description String?
  image       String?
  creatorId   String
  createdAt   DateTime          @default(now())
  creator     User              @relation(fields: [creatorId], references: [id])
  members     CommunityMember[]
}

model CommunityMember {
  id          Int       @id @default(autoincrement())
  userId      String
  communityId Int
  joinedAt    DateTime  @default(now())
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, communityId])
}

model List {
  id          Int          @id @default(autoincrement())
  name        String
  description String?
  isPrivate   Boolean      @default(false)
  ownerId     String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  owner       User         @relation("ListOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     ListMember[]

  @@index([ownerId, createdAt])
  @@index([isPrivate, createdAt])
}

model ListMember {
  id      Int      @id @default(autoincrement())
  listId  Int
  userId  String
  addedAt DateTime @default(now())
  list    List     @relation(fields: [listId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([listId, userId])
  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  actorId   String?
  type      String
  postId    String?
  message   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  actor     User?    @relation("SentNotifications", fields: [actorId], references: [id])
  user      User     @relation("ReceivedNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model Conversation {
  id        String               @id @default(cuid())
  type      String
  name      String?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  members   ConversationMember[]
  messages  Message[]
}

model ConversationMember {
  conversationId String
  userId         String
  status         String       @default("active")
  lastReadAt     DateTime     @default(now())
  joinedAt       DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId, status])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Article {
  id            String            @id @default(cuid())
  authorId      String
  title         String
  content       String
  coverImageUrl String?
  status        String            @default("published")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  publishedAt   DateTime?
  author        User              @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  bookmarks     ArticleBookmark[]
  comments      ArticleComment[]
  likes         ArticleLike[]

  @@index([authorId, createdAt])
  @@index([status, publishedAt])
}

model ArticleComment {
  id        String   @id @default(cuid())
  articleId String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User     @relation("ArticleCommentAuthor", fields: [userId], references: [id], onDelete: Cascade)

  @@index([articleId, createdAt])
  @@index([userId])
}

model ArticleLike {
  id        String   @id @default(cuid())
  articleId String
  userId    String
  createdAt DateTime @default(now())
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([articleId, userId])
  @@index([userId])
}

model ArticleBookmark {
  id        String   @id @default(cuid())
  articleId String
  userId    String
  createdAt DateTime @default(now())
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([articleId, userId])
  @@index([userId, createdAt])
}

model Bookmark {
  id        Int      @id @default(autoincrement())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId, createdAt])
}

model playing_with_neon {
  id    Int    @id @default(autoincrement())
  name  String
  value Float? @db.Real
}

model UserSettings {
  id                String   @id @default(cuid())
  userId            String   @unique

  theme             String   @default("light")
  fontSize          String   @default("medium")
  language          String   @default("id")

  protectPosts      Boolean  @default(false)
  allowPhotoTag     Boolean  @default(true)
  showInSuggestions Boolean  @default(true)

  whoCanReply       String   @default("everyone")
  whoCanTag         String   @default("everyone")
  whoCanMessage     String   @default("everyone")

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}